// ── FIRESTORE SECURITY RULES ────────────────────────────────────────────────
// These rules lock all data to authenticated users only.
// Household data is restricted to members whose UID appears in the
// household document's `memberUids` array.
//
// Data model enforced:
//   users/{uid}                          — only the owning user can read/write
//   households/{hid}                     — only members can read/update; any auth'd user can create
//   households/{hid}/{subcollection}/**  — only household members can read/write

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USER PROFILES ──
    // Each user can only read and write their own profile document.
    // No other user can see or modify someone else's profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── HOUSEHOLD DOCUMENTS ──
    match /households/{householdId} {

      // Any authenticated user can create a new household (e.g. on first login).
      // The client is responsible for adding themselves as a member.
      allow create: if request.auth != null;

      // Any authenticated user can read household metadata (name, members, invite code).
      // This is needed so new users can look up a household via invite code during the
      // join flow (before they're a member). Sensitive data lives in subcollections
      // which are still restricted to members only.
      allow read: if request.auth != null;

      // Existing members can update the household (e.g. rename, change settings).
      // Also allows new users to join: if the post-update memberUids includes the
      // requesting user's UID, the write is allowed (they're adding themselves).
      // Fallback for pre-auth household docs where householdId == uid.
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.memberUids
                        || request.auth.uid == householdId
                        || request.auth.uid in request.resource.data.memberUids);

      // Only the owner can delete the entire household.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // ── HOUSEHOLD SUBCOLLECTIONS ──
      // All subcollections (inventory, recipes, shopping, mealplan, settings,
      // cooklog, wastelog) share the same rule: the requesting user's UID must
      // appear in the parent household's `memberUids` array.
      //
      // `get()` reads the parent household doc to check membership.
      // This costs one extra read per request, but Firestore caches it within
      // the same security evaluation so multiple subcollection checks in one
      // batch don't multiply the cost.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids
                               || request.auth.uid == householdId);

      }
    }

    // ── HOUSEHOLD INVITE CODES ──
    // Top-level index: household_codes/{inviteCode} → { householdId }
    // Any authenticated user can read (so new users can look up a code to join).
    // Only household owners can create/update/delete (enforced client-side;
    // server-side rule checks that the writer owns the referenced household).
    match /household_codes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.ownerUid;
    }

    // ── PUBLIC RECIPES ──
    // Community-shared recipes. Anyone (including unauthenticated users) can read.
    // Authenticated users can create their own public recipes (authorUid must match).
    // Only the original author can update or delete their public recipe.
    // Likes and comments are handled via dedicated subcollection rules below.
    match /public_recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorUid == request.auth.uid;
    }

    // ── PUBLIC RECIPE LIKES ──
    // Each like is stored as public_recipes/{recipeId}/likes/{uid}.
    // Anyone can read likes; only the owning user can create/delete their own like.
    match /public_recipes/{recipeId}/likes/{uid} {
      allow read: if true;
      allow create, delete: if request.auth != null
                            && request.auth.uid == uid;
    }

    // ── PUBLIC RECIPE COMMENTS ──
    // Anyone can read comments. Authenticated users can add comments
    // (authorUid must match). Only the comment author can delete their own.
    match /public_recipes/{recipeId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // ── DEFAULT DENY ──
    // Any path not matched above is denied by default (Firestore's behavior).
    // This explicit match makes the intent clear.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
