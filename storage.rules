// ── FIREBASE STORAGE SECURITY RULES ─────────────────────────────────────────
// Controls who can read/write files in Firebase Storage (product images, etc.).
//
// Structure:
//   households/{householdId}/customProducts/{filename}
//     — Authenticated users can read and write product images.
//     — Images are uploaded client-side via the Firebase Storage SDK.
//     — Membership enforcement is handled at the Firestore level (the download
//       URL is stored in Firestore, which has its own member-only rules).
//     — Max file size: 500KB (images are compressed client-side to ~150KB,
//       but we allow headroom for edge cases).
//     — Only JPEG and PNG content types are allowed (prevents abuse).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── HOUSEHOLD PRODUCT IMAGES ──
    // Any authenticated user can upload/read product photos scoped to a household.
    // Fine-grained membership checks happen at the Firestore layer — Storage rules
    // just enforce auth + file constraints to prevent unauthenticated or oversized uploads.
    match /households/{householdId}/customProducts/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // ── DEFAULT DENY ──
    // Any path not matched above is denied (Firebase Storage's default behavior).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
